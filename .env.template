# Django
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,your-server-ip
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://your-domain.com
TIME_ZONE=Europe/Helsinki
LOG_LEVEL=INFO
DATABASE_CONN_MAX_AGE=60

# Security. Set True only when HTTPS is configured in front of Nginx.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# PostgreSQL
POSTGRES_DB=habit_tracker
POSTGRES_USER=habit_user
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://habit_user:replace-with-a-strong-password@db:5432/habit_tracker

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.com
CORS_ALLOW_CREDENTIALS=True

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_REQUEST_TIMEOUT=10

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Docker Compose
HTTP_PORT=80
IMAGE_TAG=latest
