# Django
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Europe/Helsinki

# Local database. No PostgreSQL or Docker is required.
DATABASE_URL=sqlite:///db.sqlite3

# CORS: addresses of frontend applications
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True

# Celery: local file-system message broker. No Redis, RabbitMQ or Docker required.
CELERY_BROKER_URL=filesystem://
CELERY_RESULT_BACKEND=cache+memory://

# Telegram
TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_REQUEST_TIMEOUT=10

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
